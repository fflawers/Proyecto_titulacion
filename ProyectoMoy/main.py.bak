    def cargar_chat():

        page.clean()

        chat_display = ft.ListView(
            expand=True,
            spacing=10,
            padding=20,
            auto_scroll=True
        )

        # =================================
        # ENVIAR MENSAJE
        # =================================

        def enviar_mensaje(e):
            if not input_msg.value:
                return

            user_text = input_msg.value
            chat_display.controls.append(
                ft.Container(
                    content=ft.Text(f"{user_info['nombre']}: {user_text}", color="white", weight="bold"),
                    bgcolor="#222222",
                    padding=10,
                    border_radius=10
                )
            )
            input_msg.value = ""
            page.update()

            try:
                db = conectar_db()
                if not db:
                    chat_display.controls.append(
                        ft.Text("ERROR: No se pudo conectar a la base de datos de manuales.", color="red")
                    )
                    page.update()
                    return
                cursor = db.cursor(dictionary=True)
                cursor.execute("SELECT * FROM manuales")
                manuales = cursor.fetchall()
                db.close()

                user_lower = user_text.lower()
                palabras_query = re.findall(r"\w+", user_lower)
                descarga_keywords = ["descargar", "descarga", "download", "bajar", "obtener archivo", "obtener pdf", "dame el pdf", "dame el manual", "puedes pasarme", "link del", "enlace del"]
                lista_keywords = ["qué manuales", "que manuales", "manuales disponibles", "lista de pdf", "qué pdf", "que pdf", "mostrar pdf", "ver pdf", "documentos disponibles", "listar manuales"]
                ask_for_pdf = any(phrase in user_lower for phrase in descarga_keywords)
                ask_for_list = any(phrase in user_lower for phrase in lista_keywords)

                stopwords = {"de", "la", "el", "los", "las", "un", "una", "pdf", "manual", "documento", "archivo", "archivos", "tienes", "telefono", "tienda", "hola", "cual", "es", "como", "donde", "por", "para", "con", "que", "quiero", "saber"}
                query_palabras = [w for w in palabras_query if w not in stopwords and len(w) > 2]

                manuales_texto = ""
                manuales_meta = []
                for manual in manuales:
                    texto_manual = manual.get("Contenido_Texto") or ""
                    nombre_archivo = manual.get("Nombre_Archivo") or ""
                    manuales_meta.append({
                        "id": manual["ID_Manual"],
                        "nombre": nombre_archivo,
                        "texto": texto_manual.lower()
                    })

                    if texto_manual:
                        lineas = texto_manual.split("\n")
                        lineas_filtradas = []
                        for linea in lineas:
                            linea_lower = linea.lower()
                            # Incluir cabeceras estructurales de Excel o PDF cortas
                            if "columna" in linea_lower or "hoja:" in linea_lower or "====" in linea_lower or len(linea) < 15:
                                lineas_filtradas.append(linea)
                                continue
                            
                            # Si no hay busqueda especifica, devolvemos todo truncado
                            if not query_palabras:
                                lineas_filtradas.append(linea)
                                continue

                            # Si sí hay palabras clave, incluimos la línea si hace match con alguna
                            if any(q in linea_lower for q in query_palabras):
                                lineas_filtradas.append(linea)

                        texto_filtrado = "\n".join(lineas_filtradas)
                        
                        manuales_texto += f"""

MANUAL / DOCUMENTO:
{nombre_archivo}

CONTENIDO:
{texto_filtrado[:8000]}

=================================
"""


                respuesta = ""
                id_manual = None
                nombre_pdf = ""

                def score_manual(meta):
                    nombre_archivo = meta["nombre"].lower()
                    nombre_palabras = [w for w in re.findall(r"\w+", nombre_archivo) if w not in stopwords]
                    score = 0
                    if nombre_archivo and nombre_archivo in user_lower:
                        score += 100
                    score += sum(10 for palabra in nombre_palabras if palabra in query_palabras)
                    score += sum(3 for palabra in nombre_palabras if palabra in user_lower)
                    score += sum(2 for palabra in query_palabras if palabra in meta["texto"])
                    return score

                def buscar_manual_relacionado():
                    mejor_manual = None
                    mejor_puntaje = 0
                    for meta in manuales_meta:
                        puntaje = score_manual(meta)
                        if puntaje > mejor_puntaje:
                            mejor_puntaje = puntaje
                            mejor_manual = meta
                    return mejor_manual, mejor_puntaje

                if ask_for_list:
                    if manuales_meta:
                        lista_nombres = ", ".join([m["nombre"] for m in manuales_meta])
                        respuesta = f"Manuales disponibles: {lista_nombres}"
                    else:
                        respuesta = "No hay manuales cargados."
                elif ask_for_pdf:
                    mejor_manual, mejor_puntaje = buscar_manual_relacionado()
                    if mejor_manual and mejor_puntaje >= 5:
                        id_manual = mejor_manual["id"]
                        nombre_pdf = mejor_manual["nombre"]
                        respuesta = f"PDF relacionado: {nombre_pdf}"
                    else:
                        respuesta = "No encontré un PDF relacionado con tu pregunta. Si quieres, haz una pregunta más específica sobre el manual."
                else:
                    if manuales_texto.strip() == "":
                        respuesta = "No hay manuales cargados para consultar."
                    else:
                        headers = {
                            "Authorization": f"Bearer {GROQ_API_KEY}",
                            "Content-Type": "application/json"
                        }

                        payload = {
                            "model": GROQ_MODEL,
                            "messages": [
                                {
                                    "role": "system",
                                    "content": f"""
Eres LUXO, asistente operativo de Sunglass Hut.

Debes responder de manera natural, amable y profesional.
Usa SOLO información encontrada dentro de los manuales y documentos proporcionados.

ATENCIÓN: Si el documento es un archivo Excel, la información estará formateada como "FILA X: Columna1: Valor | Columna2: Valor". Debes asociar correctamente las columnas con sus valores en cada fila para dar una respuesta precisa (ej: si te piden el teléfono de una tienda, busca la fila de la tienda y lee su columna 'celular' o 'teléfono').

Si no encuentras información, responde EXACTAMENTE:
Por el momento no cuento con esta información.

DOCUMENTOS / MANUALES:

{manuales_texto[:6000]}
"""
                                },
                                {
                                    "role": "user",
                                    "content": user_text
                                }
                            ]
                        }

                        res = requests.post(URL_GROQ, headers=headers, json=payload)
                        if res.status_code == 200:
                            try:
                                data = res.json()
                                if "choices" in data and data["choices"]:
                                    respuesta = data["choices"][0]["message"]["content"]
                                else:
                                    respuesta = "Ocurrió un error consultando la IA."
                            except Exception as e:
                                print("AI PARSE ERROR:", e)
                                print("AI RESPONSE TEXT:", res.text)
                                respuesta = "Ocurrió un error consultando la IA."
                        else:
                            print("AI CONNECTION ERROR:", res.status_code, res.text)
                            respuesta = f"Error de conexión con la IA ({res.status_code})."

                chat_display.controls.append(
                    ft.Container(
                        content=ft.Row([
                            ft.Container(
                                content=fv.Video(
                                    playlist=[fv.VideoMedia(video_path)],
                                    playlist_mode=fv.PlaylistMode.LOOP,
                                    autoplay=True,
                                    muted=True,
                                    controls=None,
                                    width=35,
                                    height=35,
                                ) if os.path.exists(video_path) else (
                                    ft.Image(src=img_avatar, width=35, height=35) if img_avatar else ft.Text("L", color="white", weight="bold")
                                ),
                                width=35,
                                height=35,
                                border_radius=17.5,
                                clip_behavior=ft.ClipBehavior.HARD_EDGE,
                                border=ft.Border.all(1.5, "#00FFFF"),
                            ),
                            ft.Text(f"LUXO: {respuesta}", color="white", weight="bold", expand=True),
                        ], vertical_alignment="start", spacing=10),
                        bgcolor="#111111",
                        padding=10,
                        border_radius=10
                    )
                )

                if ask_for_pdf and id_manual:
                    chat_display.controls.append(
                        ft.Container(
                            content=ft.Row([
                                ft.Icon(ft.Icons.PICTURE_AS_PDF, color="#D8B4FE"),
                                ft.Text(f"{nombre_pdf}", color="white", weight="bold", expand=True),
                                ft.ElevatedButton(
                                    "👁 Visualizar",
                                    on_click=lambda e, idm=id_manual: visualizar_pdf(idm, page),
                                    bgcolor="#6E48AA",
                                    color="white"
                                ),
                                ft.ElevatedButton(
                                    "⬇ Descargar",
                                    on_click=lambda e, idm=id_manual: descargar_pdf_archivo(idm, page),
                                    bgcolor="#444444",
                                    color="white"
                                ),
                            ], alignment="center", spacing=10),
                            bgcolor="#1a1a2e",
                            padding=10,
                            border_radius=10
                        )
                    )

                db = conectar_db()
                if not db:
                    chat_display.controls.append(
                        ft.Text("ERROR: No se pudo registrar la conversación (Base de Datos desconectada).", color="red")
                    )
                    page.update()
                    return
                cursor = db.cursor()
                sql_historial = """
                INSERT INTO historial_conversaciones
                (
                    ID_Usuario,
                    ID_Manual,
                    Pregunta_Usuario,
                    Respuesta_IA,
                    Fecha_Hora,
                    Fue_Respondida_Con_Manual
                )
                VALUES (%s, %s, %s, %s, NOW(), %s)
                """
                cursor.execute(
                    sql_historial,
                    (
                        user_info["id"],
                        id_manual,
                        user_text,
                        respuesta,
                        1,
                    )
                )
                db.commit()
                id_conversacion = cursor.lastrowid

                if "Por el momento no cuento con esta información" in respuesta:
                    sql_pendiente = """
                    INSERT INTO pendientes_actualizacion
                    (
                        ID_Conversacion,
                        Pregunta_Faltante
                    )
                    VALUES (%s, %s)
                    """
                    cursor.execute(
                        sql_pendiente,
                        (
                            id_conversacion,
                            user_text
                        )
                    )
                    db.commit()

                db.close()

            except Exception as e:
                chat_display.controls.append(
                    ft.Text(
                        f"ERROR: {e}",
                        color="red"
                    )
                )

            page.update()

        # =================================
        # INPUT
        # =================================

        input_msg = ft.TextField(
            hint_text="Escribe tu consulta...",
            expand=True,
            on_submit=enviar_mensaje,
            border_color="#9D50BB",
            color="white",
            bgcolor="#111111"
        )

        def on_cargar_manual(ev):
            seleccionar_archivo_async(
                "Seleccionar PDF para cargar",
                [("PDF files", "*.pdf")],
                procesar_cargar_pdf
            )

        def on_cargar_excel(ev):
            seleccionar_archivo_async(
                "Seleccionar Excel para cargar",
                [("Excel files", "*.xlsx *.xls"), ("Todos los archivos", "*.*")],
                procesar_cargar_excel
            )

        def on_borrar_manual(ev):
            borrar_manual_admin()

        def on_cerrar_sesion(ev):
            cerrar_sesion()

        admin_menu_button = ft.Container()
        if user_info["rol"] == "Admin":
            admin_menu_button = ft.PopupMenuButton(
                content=ft.Text("ADMIN", color="white"),
                tooltip="Menú Admin",
                bgcolor="#222222",
                items=[
                    ft.PopupMenuItem("CARGAR PDF", on_click=on_cargar_manual),
                    ft.PopupMenuItem("CARGAR EXCEL", on_click=on_cargar_excel),
                    ft.PopupMenuItem("BORRAR MANUAL", on_click=on_borrar_manual),
                    ft.PopupMenuItem("CERRAR SESIÓN", on_click=on_cerrar_sesion)
                ]
            )

        # =================================
        # INTERFAZ
        # =================================

        chat_page = ft.Column([
            ft.Row([
                ft.Text(
                    f"Bienvenido {user_info['nombre']}",
                    size=22,
                    color="#D8B4FE",
                    weight="bold"
                ),
                admin_menu_button
            ], alignment="spaceBetween", vertical_alignment="center"),
            ft.Container(
                content=chat_display,
                expand=True,
                bgcolor="#000000",
                border_radius=20,
                padding=10,
                border=ft.Border.all(2, "#D8B4FE"),
                shadow=[
                    ft.BoxShadow(
                        color="#D8B4FE",
                        blur_radius=15,
                        spread_radius=1,
                    )
                ]
            ),
            ft.Row([
                input_msg,
                ft.ElevatedButton(
                    "ENVIAR",
                    on_click=enviar_mensaje,
                    bgcolor="#6E48AA",
                    color="white"
                )
            ], spacing=10)
        ], expand=True)

        if img_fondo:
            page.add(
                ft.Container(
                    expand=True,
                    image=ft.DecorationImage(
                        src=img_fondo,
                        fit=ft.controls.box.BoxFit.COVER
                    ),
                    content=chat_page
                )
            )
        else:
            page.add(chat_page)

        page.update()

    # =====================================
    # LOGIN
    # =====================================

    def login_click(e):

        db = conectar_db()

        if not db:
            mostrar_snack("Error Base de Datos", color="#FF4B4B")
            return

        cursor = db.cursor(dictionary=True)

        cursor.execute(
            """
            SELECT
            ID_Usuario,
            Nombre_Completo,
            Rol
            FROM usuarios
            WHERE Usuario = %s
            AND Contrasena = %s
            """,
            (
                txt_user.value,
                txt_pass.value
            )
        )

        res = cursor.fetchone()

        if res:
            login_message.value = ""
            login_error_box.visible = False

            user_info["id"] = res["ID_Usuario"]
            user_info["nombre"] = res["Nombre_Completo"]
            user_info["rol"] = res["Rol"]
            cargar_chat()

        else:
            cursor.execute(
                """
                SELECT
                ID_Usuario
                FROM usuarios
                WHERE Usuario = %s
                """,
                (txt_user.value,)
            )
            usuario_existe = cursor.fetchone()

            if usuario_existe:
                mensaje = "Contraseña incorrecta"
            else:
                mensaje = "Usuario no registrado"

            login_message.value = mensaje
            login_message.color = "#FF4B4B"
            login_error_box.visible = True
            page.update()

        db.close()

    # =====================================
    # LOGIN UI
    # =====================================

    txt_user = ft.TextField(
        label="Usuario",
        width=300
    )

    txt_pass = ft.TextField(
        label="Contraseña",
        password=True,
        width=300,
        on_submit=login_click
    )

    login_message = ft.Text(
        "",
        size=16,
        weight="bold",
        color="#FF4B4B"
    )

    login_error_box = ft.Container(
        content=login_message,
        bgcolor="#000000",
        padding=10,
        border_radius=10,
        visible=False,
        width=300
    )

    video_avatar = None
    if os.path.exists(video_path):
        video_avatar = ft.Container(
            content=fv.Video(
                playlist=[fv.VideoMedia(video_path)],
                playlist_mode=fv.PlaylistMode.LOOP,
                autoplay=True,
                muted=True,
                controls=None,
                width=120,
                height=120,
            ),
            width=120,
            height=120,
            border_radius=60,
            clip_behavior=ft.ClipBehavior.HARD_EDGE,
            border=ft.Border.all(2, "#00FFFF"),
        )

    login_ui = ft.Container(

        content=ft.Column([

            video_avatar if video_avatar else (
                ft.Image(
                    src=img_avatar,
                    width=120,
                    height=120,
                    fit=ft.controls.box.BoxFit.COVER
                ) if img_avatar else ft.Text(
                    "LUXO",
                    size=30,
                    color="#FFFFFF",
                    weight="bold"
                )
            ),

            login_error_box,

            ft.Text(
                "SISTEMA LUXO",
                size=25,
                weight="bold",
                color="#D8B4FE"
            ),

            txt_user,

            txt_pass,

            ft.ElevatedButton(
                "INGRESAR",
                on_click=login_click,
                width=300,
                bgcolor="#6E48AA",
                color="white"
            )

        ],
        horizontal_alignment="center",
        spacing=20),

        padding=40,
        bgcolor="#000000",
        border_radius=20,
        border=ft.Border.all(2, "#00FFFF"),
        shadow=[
            ft.BoxShadow(
                color="#00FFFF",
                blur_radius=15,
                spread_radius=1,
            )
        ],
        clip_behavior=ft.ClipBehavior.HARD_EDGE
    )

    page.vertical_alignment = "center"

    page.horizontal_alignment = "center"

    page.add(login_ui)

# =========================================
# EJECUTAR APP
# =========================================

ft.app(target=main)

